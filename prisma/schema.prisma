// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  engineType      = "client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = []
}

model auth {
  aid       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String    @unique
  username  String    @unique
  password  String
  userId    String
  ccy       String
}

model txnSuspect {
  batchId   String    @id
  asset     String
  debitAcc  String
  creditAcc String
  txnCode   String
  amount    Float
  narative  String
  userId    String
}

model depositSuspect {
  exId      String    @id
  method    String
  desc      String
}

model txnSucess {
  exId      String    @id
  txnId     String
}